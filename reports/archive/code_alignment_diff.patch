-+OFFICIAL_CHECKPOINT_FILENAME = "2025-11-04_sap-rpt-one-oss.pt"
-+OFFICIAL_CHECKPOINT_REPO = "SAP/sap-rpt-1-oss"
-+
-+
-+def download_official_ckpt() -> Path:
-+    """Download the official sap/sap-rpt-1-oss weight-shared checkpoint."""
-+    return Path(
-+        hf_hub_download(
